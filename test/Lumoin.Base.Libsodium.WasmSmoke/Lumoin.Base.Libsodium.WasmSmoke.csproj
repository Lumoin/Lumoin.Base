<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <!-- This project targets net11.0 like the whole repository (Directory.Build.props) and needs
         the wasm-tools workload for the native relink (see the wasm-smoke workflow). -->
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Same reason as the shipping library and its test project: obtaining the scratch pointer
         from MemoryHandle.Pointer requires unsafe context. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- A smoke host, not a shippable library: trim/AOT analyzers and the resource-table rule for
         console literals (CA1303) would only produce noise here, matching the test projects. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <NoWarn>$(NoWarn);CA1303</NoWarn>

    <!-- Not part of the locked-restore solution build (deliberately absent from Lumoin.Base.slnx):
         only the wasm-smoke workflow restores this project, on the repository's SDK pin
         (global.json), whose implicit net11.0 package graph shifts per SDK release, so a committed
         lock file would churn without adding integrity. Restoring it on that pin leaves the
         referenced projects' committed packages.lock.json files unchanged. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>

    <!-- Relink dotnet.wasm with the family-built static libsodium. The archive path comes in via
         -p:LibsodiumStaticLibrary=<path to libsodium.a>; without it the project still compiles but
         the smoke run would fail at the first native call — the workflow always passes it. -->
    <WasmBuildNative Condition="'$(LibsodiumStaticLibrary)' != ''">true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup Condition="'$(LibsodiumStaticLibrary)' != ''">
    <NativeFileReference Include="$(LibsodiumStaticLibrary)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lumoin.Base/Lumoin.Base.csproj" />
    <ProjectReference Include="../../src/Lumoin.Base.Libsodium/Lumoin.Base.Libsodium.csproj" />
  </ItemGroup>

</Project>
