<Project>

  <!-- Wires the family-built libsodium native assets into the two consumer surfaces
       PackageReference resolution alone cannot reach: the iOS/Mac Catalyst static xcframework
       and the browser-wasm static archive. -->

  <!-- iOS and Mac Catalyst do not consume runtimes/<rid>/native shared libraries: the static
       archive slices inside xcframeworks/libsodium.xcframework (arm64 device, arm64/x86_64
       simulator and Catalyst) are linked into the app binary by the Apple toolchain through this
       NativeReference. The Exists() guard keeps a package that was packed without native assets
       (a local dotnet pack without -p:AppleXcframeworkDirectory) harmless to consumers. -->

  <PropertyGroup>
    <_LumoinLibsodiumXcframework>$(MSBuildThisFileDirectory)../xcframeworks/libsodium.xcframework</_LumoinLibsodiumXcframework>
  </PropertyGroup>

  <ItemGroup Condition="('$(TargetPlatformIdentifier)' == 'ios' Or '$(TargetPlatformIdentifier)' == 'maccatalyst') And Exists('$(_LumoinLibsodiumXcframework)')">
    <NativeReference Include="$(_LumoinLibsodiumXcframework)">
      <Kind>Static</Kind>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>

  <!-- The wasm SDK links NativeFileReference items into dotnet.wasm at publish
       (BrowserWasmApp.targets adds every NativeFileReference to _WasmNativeFileForLinking), which
       needs the consuming app to have the wasm-tools workload installed. The archive is built
       with that workload's own Emscripten on the SDK band the package targets, and the check
       below warns when the consumer's workload reports a different version. The Exists() guard
       keeps a package packed without native assets harmless to consumers, same as the
       xcframework above. -->

  <PropertyGroup>
    <_LumoinLibsodiumWasmArchive>$(MSBuildThisFileDirectory)../runtimes/browser-wasm/native/libsodium.a</_LumoinLibsodiumWasmArchive>
    <_LumoinLibsodiumWasmArchiveEmscriptenVersionFile>$(_LumoinLibsodiumWasmArchive).emscripten-version</_LumoinLibsodiumWasmArchiveEmscriptenVersionFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And Exists('$(_LumoinLibsodiumWasmArchive)')">
    <NativeFileReference Include="$(_LumoinLibsodiumWasmArchive)" />
  </ItemGroup>

  <!-- The archive is guaranteed to link only against the Emscripten it was built with (a nearby
       version usually links too, but nothing promises it). The natives job stamps that version
       beside the archive, read from the workload's emscripten-version.txt, the same file the
       workload's Sdk.props publishes as $(EmscriptenVersion). A mismatch is reported here as
       warning LUMOIN0001, naming both versions, instead of surfacing later as an opaque link
       error. Suppress with NoWarn when the mismatch is known to link. -->

  <Target Name="LumoinLibsodiumCheckWasmEmscriptenVersion"
          BeforeTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'browser-wasm' And Exists('$(_LumoinLibsodiumWasmArchive)') And Exists('$(_LumoinLibsodiumWasmArchiveEmscriptenVersionFile)')">
    <PropertyGroup>
      <_LumoinLibsodiumWasmArchiveEmscriptenVersion>$([System.IO.File]::ReadAllText('$(_LumoinLibsodiumWasmArchiveEmscriptenVersionFile)').Trim())</_LumoinLibsodiumWasmArchiveEmscriptenVersion>
    </PropertyGroup>

    <Warning Code="LUMOIN0001"
             Condition="'$(EmscriptenVersion)' != '' And '$(EmscriptenVersion)' != '$(_LumoinLibsodiumWasmArchiveEmscriptenVersion)'"
             Text="Lumoin.Base.Libsodium's browser-wasm libsodium.a was built with Emscripten $(_LumoinLibsodiumWasmArchiveEmscriptenVersion), but this wasm-tools workload pins Emscripten $(EmscriptenVersion); the static link into dotnet.wasm may fail. Build with the .NET SDK band the package was built for, or use a package built for this one." />
  </Target>

</Project>
